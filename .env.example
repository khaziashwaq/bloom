# Public URL of the deployed site (used for link previews / Open Graph images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: persistent storage for shared bouquets.
# Without these, every share link carries the whole bouquet inside it (works on any device, no backend).
# With them, bouquets are saved to Supabase and links become short: /b/<id>
# Set up the table by running supabase/schema.sql in the Supabase SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
